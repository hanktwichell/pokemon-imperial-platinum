option('gdb_debugging', type : 'boolean', value : false)
option('revision', type : 'combo', choices: ['0', '1'], value : '1')
option('logging_enabled', type: 'boolean', value: false)
option('sovereign_test', type: 'boolean', value: false, description: 'Sovereign test build (never ship): test party at new game, SELECT starts a wild battle, SELECT+R a trainer battle')
option('platinum_fronts', type: 'boolean', value: false, description: 'Platinum\'s own front sprites (80x80, two animation frames) for species #1-493 instead of PokeAPI\'s 96x96 Black/White fronts')
