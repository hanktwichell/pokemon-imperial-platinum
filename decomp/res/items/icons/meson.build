item_icon_anim_jsons = files('generic_anim.json')
item_icon_cell_jsons = files('generic_cell.json')

item_icon_nanrs = nanr_gen.process(item_icon_anim_jsons)
item_icon_ncers = ncer_gen.process(item_icon_cell_jsons)

item_icon_ncgrs = ncgr_gen.process(item_icon_pngs,
    extra_args: [
        '-clobbersize',
        '-version101',
        '-mappingtype', '0'
    ]
)

item_icon_nclrs = nclr_gen.process(item_icon_pals,
    extra_args: [
        '-bitdepth', '4',
    ]
)

