    {
      "id": "FightAreaPokecenter1F_Text_SovereignEventGiftsIntro",
      "en_US": [
        "Special delivery! I bring Pokémon\n",
        "from events all over the world.\r",
        "Each one only once, mind you.\n",
        "Which one would you like?"
      ]
    },
