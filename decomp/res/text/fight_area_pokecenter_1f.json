    {
      "id": "FightAreaPokecenter1F_Text_SovereignEventGiftsBye",
      "en_US": [
        "Come by anytime for a delivery!"
      ]
    },
    {
      "id": "FightAreaPokecenter1F_Text_SovereignEventGiftsRestyleAsk",
      "en_US": [
        "That one’s a Mythical Pokémon. I can’t\n",
        "deliver it, but I can restyle yours!\r",
        "Show me your {STRVAR_1 1, 0, 0}."
      ]
    },
    {
      "id": "FightAreaPokecenter1F_Text_SovereignEventGiftsRestyled",
      "en_US": [
        "There! Your {STRVAR_1 1, 0, 0} looks just\n",
