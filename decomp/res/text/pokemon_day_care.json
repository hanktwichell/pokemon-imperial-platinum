      "id": "PokemonDayCare_Text_SovereignTrayneeWhatExpLevel",
      "en_US": [
        "Experience training? OK.\n",
        "What level should we train at?"
      ]
    },
    {
      "id": "PokemonDayCare_Text_SovereignTrayneeNotStrongEnough",
      "en_US": [
        "Ah, fiddlesticks.\r",
        "I don’t think you’re strong enough\n",
        "for that level of training yet."
      ]
    },
    {
      "id": "PokemonDayCare_Text_SovereignRancherSellBerries",
      "en_US": [
        "I’ve got me some sweet and juicy\n",
        "berries from the local fields.\r",
        "They’ll make ya Pokémon happy!\n",
        "Oh yes, so very happy!\r",
        "I’ll sell ya a whole batch for $5000."
      ]
    },
    {
      "id": "PokemonDayCare_Text_SovereignRancherNotEnoughMoney",
      "en_US": [
        "Aye, sorry, partner.\n",
        "You don’t have enough money."
      ]
    },
    {
      "id": "PokemonDayCare_Text_SovereignRancherDontWant",
      "en_US": [
        "You don’t want these here sweet and\n",
        "juicy berries?"
      ]
    },
    {
      "id": "PokemonDayCare_Text_SovereignRancherHereYouGo",
      "en_US": [
        "Good choice, partner! Here ya go!\r",
        "Fifteen each of Pomeg, Kelpsy, Qualot,\n",
        "Hondew, Grepa and Tamato Berries!"
      ]
    },
    {
      "id": "PokemonDayCare_Text_SovereignRancherBagFull",
      "en_US": [
        "Whoa there, partner!\n",
        "Your Bag can’t hold them all."
      ]
    }
